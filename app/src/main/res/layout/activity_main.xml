<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/winamp_bg"
    android:orientation="vertical"
    android:padding="4dp"
    tools:context=".MainActivity">

    <!-- ==================== WINAMP MAIN PLAYER WINDOW ==================== -->
    <com.winamp.classic.ui.WinampCanvasPlayerView
        android:id="@+id/winampMainCanvasPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ==================== WINAMP EQUALIZER WINDOW ==================== -->
    <com.winamp.classic.ui.WinampEqualizerView
        android:id="@+id/winampEqualizerWindow"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="4dp" />

    <!-- ==================== WINAMP PLAYLIST WINDOW ==================== -->
    <com.winamp.classic.ui.WinampCanvasPlaylistView
        android:id="@+id/winampPlaylistCanvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1" />

    <!-- Milkdrop Visualizer -->
    <LinearLayout
        android:id="@+id/milkdropWindow"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="4dp">

        <com.winamp.classic.ui.MilkdropVisualizerView
            android:id="@+id/milkdropVisualizerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/winampAlbumArtWindow"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <com.winamp.classic.ui.WinampAlbumArtView
            android:id="@+id/winampAlbumArtView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</LinearLayout>
