<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_winamp_window"
    android:orientation="vertical"
    android:padding="3dp">

    <!-- Title Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="@drawable/bg_winamp_title"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.15"
            android:text="WINAMP EQUALIZER"
            android:textColor="@color/winamp_title_gold"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="✕"
            android:textColor="#A0A8C0"
            android:textSize="10sp" />
    </RelativeLayout>

    <!-- Top EQ Buttons: ON, AUTO, PRESETS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEqOn"
            android:layout_width="38dp"
            android:layout_height="22dp"
            android:background="@drawable/selector_winamp_btn"
            android:padding="0dp"
            android:text="ON"
            android:textColor="@color/winamp_led_green"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btnEqAuto"
            android:layout_width="42dp"
            android:layout_height="22dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/selector_winamp_btn"
            android:padding="0dp"
            android:text="AUTO"
            android:textColor="#E0E6FF"
            android:textSize="9sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnEqPresets"
            android:layout_width="65dp"
            android:layout_height="22dp"
            android:background="@drawable/selector_winamp_btn"
            android:padding="0dp"
            android:text="PRESETS"
            android:textColor="#E0E6FF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- 10 Vertical Equalizer Band Sliders -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 60Hz -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.winamp.classic.ui.VerticalSeekBar
                android:id="@+id/seekEq60"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:max="24"
                android:progress="12"
                android:progressTint="#70768C"
                android:thumb="@drawable/thumb_silver_slider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="60"
                android:textColor="@color/winamp_led_green"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 170Hz -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.winamp.classic.ui.VerticalSeekBar
                android:id="@+id/seekEq170"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:max="24"
                android:progress="12"
                android:progressTint="#70768C"
                android:thumb="@drawable/thumb_silver_slider" />

            <TextView
