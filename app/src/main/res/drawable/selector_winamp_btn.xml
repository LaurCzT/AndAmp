<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2D303C" />
            <stroke android:width="1dp" android:color="#1A1C24" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#4A4E62" android:endColor="#343746" android:angle="270" />
            <stroke android:width="1dp" android:color="#686F8B" />
        </shape>
    </item>
</selector>
